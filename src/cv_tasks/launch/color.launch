<launch>
  <!-- roslaunch cv_tasks color.launch video:=/path/to/video.mp4 -->
  <arg name="video"/>
  <arg name="fps" default="0"/>            <!-- 0 = use the video's own fps -->
  <arg name="loop" default="false"/>
  <arg name="show" default="true"/>
  <arg name="save_to" default=""/>         <!-- e.g. results/color.mp4 -->
  <arg name="proc_width" default="640"/>
  <node pkg="cv_tasks" type="video_publisher.py" name="video_publisher" output="screen">
    <param name="video" value="$(arg video)"/>
    <param name="fps" value="$(arg fps)"/>
    <param name="loop" value="$(arg loop)"/>
  </node>

  <node pkg="cv_tasks" type="color_subscriber.py" name="color_node" output="screen">
    <param name="show" value="$(arg show)"/>
    <param name="save_to" value="$(arg save_to)"/>
    <param name="proc_width" value="$(arg proc_width)"/>
  </node>
</launch>
